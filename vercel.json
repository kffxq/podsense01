<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PodSense</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=IBM+Plex+Mono:wght@300;400&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg:      #0c0c0e;
  --bg1:     #111113;
  --bg2:     #17171a;
  --bg3:     #1d1d21;
  --line:    #26262c;
  --txt:     #e8e6e1;
  --txt2:    #8a8894;
  --txt3:    #44434d;
  --accent:  #a8ff78;
  --accent2: #56cfb2;
  --red:     #ff6b6b;
  --r:       6px;
}

html, body {
  height: 100%; width: 100%; overflow: hidden;
  background: var(--bg); color: var(--txt);
  font-family: 'Inter', system-ui, sans-serif;
  font-size: 14px; line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

::-webkit-scrollbar { width: 3px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--line); border-radius: 3px; }

/* ── LANDING ─────────────────────────────────────────────── */
#landing {
  position: fixed; inset: 0; z-index: 100;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  background: var(--bg); transition: opacity 0.35s ease;
}

.l-title {
  font-size: clamp(2.8rem, 7vw, 5.5rem);
  font-weight: 600; letter-spacing: -0.03em;
  color: var(--txt); margin-bottom: 10px; text-align: center;
}
.l-title span { color: var(--accent); }

.l-sub {
  font-size: 0.88rem; color: var(--txt2);
  font-weight: 300; margin-bottom: 36px; text-align: center;
}

.l-row {
  display: flex; width: min(520px, 90vw);
  border: 1px solid var(--line); border-radius: var(--r);
  overflow: hidden; background: var(--bg2); transition: border-color 0.2s;
}
.l-row:focus-within { border-color: rgba(168,255,120,0.4); }

.l-row input {
  flex: 1; background: transparent; border: none; color: var(--txt);
  font-family: 'IBM Plex Mono', monospace; font-size: 0.8rem;
  padding: 13px 14px; outline: none; min-width: 0;
}
.l-row input::placeholder { color: var(--txt3); }

.l-row button {
  background: var(--accent); color: #0c0c0e; border: none;
  padding: 0 20px; font-family: 'Inter', sans-serif;
  font-weight: 600; font-size: 0.82rem; cursor: pointer;
  transition: background 0.15s; white-space: nowrap; flex-shrink: 0;
}
.l-row button:hover { background: #8fe85e; }

.l-err {
  margin-top: 10px; font-size: 0.78rem; color: var(--red);
  opacity: 0; transition: opacity 0.2s; height: 18px;
}
.l-err.show { opacity: 1; }

.l-note { margin-top: 14px; font-size: 0.72rem; color: var(--txt3); letter-spacing: 0.04em; }

/* ── APP ─────────────────────────────────────────────────── */
#app { display: none; flex-direction: column; height: 100vh; }

/* TOPBAR */
#topbar {
  height: 46px; flex-shrink: 0;
  display: flex; align-items: center; gap: 10px; padding: 0 14px;
  background: var(--bg1); border-bottom: 1px solid var(--line); z-index: 10;
}

.tb-logo { font-size: 0.85rem; font-weight: 600; color: var(--accent); flex-shrink: 0; }

.tb-url {
  flex: 1; display: flex; align-items: center;
  background: var(--bg2); border: 1px solid var(--line);
  border-radius: var(--r); overflow: hidden; transition: border-color 0.2s; min-width: 0;
}
.tb-url:focus-within { border-color: rgba(168,255,120,0.3); }

.tb-url input {
  flex: 1; background: transparent; border: none; color: var(--txt);
  font-family: 'IBM Plex Mono', monospace; font-size: 0.75rem;
  padding: 6px 10px; outline: none; min-width: 0;
}
.tb-url input::placeholder { color: var(--txt3); }

.tb-url button {
  background: transparent; border: none; border-left: 1px solid var(--line);
  color: var(--accent); font-family: 'Inter', sans-serif; font-size: 0.75rem;
  font-weight: 500; padding: 6px 12px; cursor: pointer;
  transition: background 0.15s; flex-shrink: 0;
}
.tb-url button:hover { background: rgba(168,255,120,0.07); }

.mic-btn {
  display: flex; align-items: center; gap: 6px;
  background: transparent; border: 1px solid var(--line);
  color: var(--txt2); font-family: 'Inter', sans-serif; font-size: 0.75rem;
  padding: 5px 12px; border-radius: 20px; cursor: pointer;
  transition: all 0.2s; user-select: none; flex-shrink: 0; white-space: nowrap;
}
.mic-btn:hover { border-color: #444; color: var(--txt); }
.mic-btn.on { color: #4ade80; border-color: rgba(74,222,128,0.35); }
.mic-dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; flex-shrink: 0; }
.mic-btn.on .mic-dot { animation: blink 1s ease-in-out infinite; }
@keyframes blink { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.25;transform:scale(0.55)} }

/* VIDEO */
#video-wrap { flex: 1; background: #000; position: relative; min-height: 0; overflow: hidden; }

#yt { position: absolute; inset: 0; width: 100%; height: 100%; border: none; display: none; }

#vid-ph {
  position: absolute; inset: 0; display: flex;
  flex-direction: column; align-items: center; justify-content: center;
  gap: 12px; background: #000;
}
.ph-icon { font-size: 2rem; color: var(--txt3); }
.ph-txt { font-size: 0.82rem; color: var(--txt3); font-weight: 300; }

/* BOTTOM PANEL */
#panel {
  height: 240px; flex-shrink: 0;
  display: grid; grid-template-columns: 1fr 1px 300px 1px 280px;
  background: var(--bg1); border-top: 1px solid var(--line); overflow: hidden;
}
.pdiv { background: var(--line); }

.pcol { display: flex; flex-direction: column; overflow: hidden; min-width: 0; }

.phd {
  display: flex; align-items: center; justify-content: space-between;
  padding: 8px 12px 7px; border-bottom: 1px solid var(--line); flex-shrink: 0;
}
.plbl { font-size: 0.62rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--txt3); }
.pmeta { font-family: 'IBM Plex Mono', monospace; font-size: 0.62rem; color: var(--txt3); }

/* transcript */
#tx-scroll {
  flex: 1; overflow-y: auto; padding: 8px 12px;
  display: flex; flex-direction: column; gap: 3px;
}

.tx-empty {
  flex: 1; display: flex; align-items: center; justify-content: center;
  text-align: center; font-size: 0.78rem; color: var(--txt3);
  font-weight: 300; padding: 10px; line-height: 1.75;
}

.tx-line {
  font-size: 0.78rem; line-height: 1.6; color: var(--txt3);
  padding: 2px 5px; border-radius: 3px; transition: color 0.4s;
}
.tx-line .ts {
  font-family: 'IBM Plex Mono', monospace; font-size: 0.62rem;
  color: rgba(168,255,120,0.28); margin-right: 6px;
}
.tx-line.fresh { color: #c0bfba; }
.tx-line.lit {
  color: var(--txt); background: rgba(168,255,120,0.06);
  border-left: 2px solid rgba(168,255,120,0.45); padding-left: 7px;
}
.tx-interim { font-size: 0.76rem; color: var(--txt3); font-style: italic; padding: 2px 5px; }

/* ask */
.ask-body { flex: 1; display: flex; flex-direction: column; padding: 10px 12px; gap: 8px; overflow: hidden; }

.ask-ta {
  flex: 1; background: var(--bg2); border: 1px solid var(--line);
  border-radius: var(--r); color: var(--txt); font-family: 'Inter', sans-serif;
  font-size: 0.78rem; line-height: 1.6; padding: 8px 10px; resize: none;
  outline: none; transition: border-color 0.2s; min-height: 0; font-weight: 300;
}
.ask-ta:focus { border-color: rgba(168,255,120,0.3); }
.ask-ta::placeholder { color: var(--txt3); font-weight: 300; }

.ask-btn {
  background: var(--accent); color: #0c0c0e; border: none;
  border-radius: var(--r); padding: 9px; cursor: pointer; flex-shrink: 0;
  font-family: 'Inter', sans-serif; font-weight: 600; font-size: 0.78rem;
  display: flex; align-items: center; justify-content: center; gap: 6px;
  transition: background 0.15s;
}
.ask-btn:hover { background: #8fe85e; }
.ask-btn:disabled { background: var(--bg3); color: var(--txt3); cursor: not-allowed; }

.ask-hint { font-size: 0.63rem; color: var(--txt3); text-align: center; flex-shrink: 0; }

/* context cards */
#ctx-scroll {
  flex: 1; overflow-y: auto; padding: 8px 12px;
  display: flex; flex-direction: column; gap: 8px;
}

.ctx-empty {
  flex: 1; display: flex; align-items: center; justify-content: center;
  text-align: center; font-size: 0.78rem; color: var(--txt3);
  font-weight: 300; padding: 10px; line-height: 1.75;
}

.card {
  background: var(--bg2); border: 1px solid var(--line); border-radius: var(--r);
  overflow: hidden; flex-shrink: 0; animation: up 0.28s cubic-bezier(0.22,1,0.36,1);
}
@keyframes up { from{opacity:0;transform:translateY(6px)} to{opacity:1;transform:translateY(0)} }

.card-hd {
  display: flex; align-items: center; justify-content: space-between;
  padding: 6px 10px; background: var(--bg3); border-bottom: 1px solid var(--line);
}
.card-ts {
  font-family: 'IBM Plex Mono', monospace; font-size: 0.63rem; color: var(--accent);
  display: flex; align-items: center; gap: 5px;
}
.card-ts::before { content:''; width:5px; height:5px; background:var(--accent); border-radius:50%; flex-shrink:0; }
.card-wall { font-size: 0.63rem; color: var(--txt3); }

.card-body { padding: 10px; display: flex; flex-direction: column; gap: 8px; }
.card-slbl { font-size: 0.58rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--txt3); margin-bottom: 4px; }
.card-sum { font-size: 0.78rem; line-height: 1.65; color: #b0aead; font-weight: 300; }
.card-terms { display: flex; flex-direction: column; gap: 4px; }
.card-term { background: var(--bg3); border-radius: 4px; padding: 6px 8px; }
.card-tname { font-family: 'IBM Plex Mono', monospace; font-size: 0.67rem; color: var(--accent2); margin-bottom: 2px; }
.card-tdef { font-size: 0.74rem; color: var(--txt3); line-height: 1.5; font-weight: 300; }
.card-analogy {
  background: rgba(168,255,120,0.04); border: 1px solid rgba(168,255,120,0.1);
  border-radius: 4px; padding: 7px 9px;
  font-size: 0.76rem; color: rgba(168,255,120,0.65); line-height: 1.6;
  font-style: italic; font-weight: 300;
}

.loader {
  background: var(--bg2); border: 1px solid var(--line); border-radius: var(--r);
  padding: 12px; display: flex; align-items: center; gap: 10px; flex-shrink: 0;
}
.ldots { display: flex; gap: 4px; }
.ldots span { width: 5px; height: 5px; background: var(--accent); border-radius: 50%; animation: bounce 1.1s ease-in-out infinite; }
.ldots span:nth-child(2){animation-delay:0.15s} .ldots span:nth-child(3){animation-delay:0.3s}
@keyframes bounce{0%,80%,100%{transform:translateY(0);opacity:0.3}40%{transform:translateY(-4px);opacity:1}}
.ltxt { font-size: 0.76rem; color: var(--txt2); font-weight: 300; font-style: italic; }

.toast {
  position: fixed; bottom: 260px; left: 50%; transform: translateX(-50%);
  background: var(--bg3); color: var(--txt); border: 1px solid var(--line);
  padding: 7px 14px; border-radius: var(--r); font-size: 0.76rem;
  z-index: 999; pointer-events: none; white-space: nowrap; animation: up 0.25s ease-out;
}
</style>
</head>
<body>

<!-- LANDING -->
<div id="landing">
  <p class="l-title">Pod<span>Sense</span></p>
  <p class="l-sub">understand any podcast, in real time</p>
  <div class="l-row">
    <input id="l-inp" type="text" placeholder="https://youtube.com/watch?v=..." autocomplete="off" spellcheck="false" />
    <button onclick="launch()">Watch →</button>
  </div>
  <div class="l-err" id="l-err">Please paste a valid YouTube URL</div>
  <p class="l-note">Works with any YouTube video · podcasts, lectures, interviews</p>
</div>

<!-- APP -->
<div id="app">
  <div id="topbar">
    <span class="tb-logo">PodSense</span>
    <div class="tb-url">
      <input id="tb-inp" type="text" placeholder="Paste YouTube URL to switch video…" autocomplete="off" spellcheck="false" />
      <button onclick="switchVid()">Load</button>
    </div>
    <button class="mic-btn" id="mic-btn" onclick="toggleMic()">
      <span class="mic-dot"></span>
      <span id="mic-lbl">Start listening</span>
    </button>
  </div>

  <div id="video-wrap">
    <div id="vid-ph">
      <div class="ph-icon">▶</div>
      <div class="ph-txt">Loading video…</div>
    </div>
    <iframe id="yt"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen></iframe>
  </div>

  <div id="panel">
    <div class="pcol">
      <div class="phd">
        <span class="plbl">Transcript</span>
        <span class="pmeta" id="wc">0 words</span>
      </div>
      <div id="tx-scroll">
        <div class="tx-empty" id="tx-empty">
          Click <strong style="color:rgba(168,255,120,0.55)">Start listening</strong> then play the video.<br>
          Speech appears here in real time.
        </div>
      </div>
    </div>

    <div class="pdiv"></div>

    <div class="pcol">
      <div class="phd"><span class="plbl">Ask</span></div>
      <div class="ask-body">
        <textarea class="ask-ta" id="ask-ta"
          placeholder="Optional: paste a specific term or quote you want explained.&#10;&#10;Or just hit the button — it uses the last 90s of transcript automatically."></textarea>
        <button class="ask-btn" id="ask-btn" onclick="explain()">✦ &nbsp;Explain this moment</button>
        <div class="ask-hint">Press E anytime · captures last ~90 seconds</div>
      </div>
    </div>

    <div class="pdiv"></div>

    <div class="pcol">
      <div class="phd">
        <span class="plbl">Context</span>
        <span class="pmeta" id="ccount"></span>
      </div>
      <div id="ctx-scroll">
        <div class="ctx-empty" id="ctx-empty">Explanations appear here — one card per moment you ask about.</div>
      </div>
    </div>
  </div>
</div>

<script>
'use strict';

// ── STATE ──────────────────────────────────────────────────
let lines  = [];
let recog  = null;
let micOn  = false;
let t0     = null;
let iEl    = null;
let cardN  = 0;

// ── UTILS ──────────────────────────────────────────────────
const $       = id => document.getElementById(id);
const esc     = s  => String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
const scrollB = id => { const e=$(id); e.scrollTop = e.scrollHeight; };

function toast(msg) {
  const t = document.createElement('div');
  t.className = 'toast'; t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(() => t.remove(), 2600);
}

function elapsed() {
  if (!t0) return '00:00';
  const s = Math.floor((Date.now() - t0) / 1000);
  return String(Math.floor(s/60)).padStart(2,'0') + ':' + String(s%60).padStart(2,'0');
}

// ── YOUTUBE ────────────────────────────────────────────────
function parseVid(raw) {
  const s = (raw||'').trim();
  const ps = [
    /[?&]v=([a-zA-Z0-9_-]{11})/,
    /youtu\.be\/([a-zA-Z0-9_-]{11})/,
    /\/embed\/([a-zA-Z0-9_-]{11})/,
    /\/shorts\/([a-zA-Z0-9_-]{11})/,
    /\/live\/([a-zA-Z0-9_-]{11})/,
    /^([a-zA-Z0-9_-]{11})$/
  ];
  for (const p of ps) { const m = s.match(p); if (m) return m[1]; }
  return null;
}

function embedUrl(vid) {
  // On a real https domain, origin works perfectly — this fixes Error 153
  const origin = location.origin;
  return `https://www.youtube-nocookie.com/embed/${vid}?autoplay=1&rel=0&modestbranding=1&origin=${encodeURIComponent(origin)}`;
}

function loadVid(vid) {
  const fr = $('yt'), ph = $('vid-ph');
  fr.style.display = 'none';
  fr.src = '';
  ph.style.display = 'flex';
  // Small tick lets the browser clear the old player before loading new src
  requestAnimationFrame(() => setTimeout(() => {
    fr.src = embedUrl(vid);
    fr.style.display = 'block';
    ph.style.display = 'none';
  }, 80));
}

// ── LANDING ────────────────────────────────────────────────
function launch() {
  const vid = parseVid($('l-inp').value);
  if (!vid) { const e=$('l-err'); e.classList.add('show'); setTimeout(()=>e.classList.remove('show'),2500); return; }
  const land = $('landing');
  land.style.opacity = '0';
  setTimeout(() => { land.style.display='none'; $('app').style.display='flex'; }, 350);
  $('tb-inp').value = $('l-inp').value.trim();
  loadVid(vid);
}
$('l-inp').addEventListener('keydown', e => { if (e.key==='Enter') launch(); });

function switchVid() {
  const vid = parseVid($('tb-inp').value);
  if (!vid) { $('tb-inp').style.borderColor='rgba(255,107,107,0.4)'; setTimeout(()=>$('tb-inp').style.borderColor='',1500); return; }
  loadVid(vid);
}
$('tb-inp').addEventListener('keydown', e => { if (e.key==='Enter') switchVid(); });

// ── MIC ────────────────────────────────────────────────────
function toggleMic() { micOn ? stopMic() : startMic(); }

function startMic() {
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  if (!SR) { alert('Speech Recognition requires Chrome or Edge.\n\nYou can still paste quotes into the Ask box manually.'); return; }
  recog = new SR();
  recog.continuous = true; recog.interimResults = true; recog.lang = 'en-US';
  t0 = Date.now();
  recog.onstart  = () => { micOn=true; setMicUI(true); $('tx-empty').style.display='none'; };
  recog.onresult = onResult;
  recog.onerror  = ev => {
    if (ev.error==='not-allowed') { alert('Microphone access denied.\n\nAllow mic in your browser address bar, then try again.'); stopMic(); }
  };
  recog.onend = () => { if (micOn) recog.start(); };
  recog.start();
}

function stopMic() {
  micOn = false;
  if (recog) { try { recog.stop(); } catch(e){} recog = null; }
  setMicUI(false);
}

function setMicUI(on) {
  $('mic-btn').classList.toggle('on', on);
  $('mic-lbl').textContent = on ? 'Listening…' : 'Start listening';
}

function onResult(e) {
  let interim = '';
  for (let i = e.resultIndex; i < e.results.length; i++) {
    const r = e.results[i];
    if (r.isFinal) {
      const t = r[0].transcript.trim();
      if (t) { addLine(t); if (iEl) { iEl.remove(); iEl=null; } }
    } else {
      interim += r[0].transcript;
    }
  }
  if (interim) {
    if (!iEl) { iEl = document.createElement('div'); iEl.className='tx-interim'; $('tx-scroll').appendChild(iEl); }
    iEl.textContent = interim;
    scrollB('tx-scroll');
  }
}

function addLine(text) {
  const stamp = elapsed();
  lines.push({ text, stamp, time: Date.now() });
  $('tx-scroll').querySelectorAll('.tx-line.fresh').forEach(el => el.classList.remove('fresh'));
  const d = document.createElement('div');
  d.className = 'tx-line fresh';
  d.innerHTML = `<span class="ts">${stamp}</span>${esc(text)}`;
  $('tx-scroll').appendChild(d);
  scrollB('tx-scroll');
  $('wc').textContent = lines.reduce((a,l)=>a+l.text.split(/\s+/).length,0) + 'w';
}

// ── EXPLAIN ────────────────────────────────────────────────
async function explain() {
  const btn = $('ask-btn');
  btn.disabled = true; btn.textContent = '⟳  Thinking…';

  const now    = Date.now();
  const recent = lines.filter(l => now - l.time < 90000);
  const txText = recent.map(l=>`[${l.stamp}] ${l.text}`).join('\n');
  const manual = $('ask-ta').value.trim();
  const parts  = [];
  if (txText) parts.push(`TRANSCRIPT (last ~90 seconds):\n${txText}`);
  if (manual) parts.push(`USER QUOTE:\n"${manual}"`);
  const input = parts.join('\n\n');

  if (!input) {
    toast('Nothing to explain yet — start listening or paste a quote above');
    btn.disabled=false; btn.innerHTML='✦ &nbsp;Explain this moment'; return;
  }

  // Highlight transcript lines being explained
  const allLines = $('tx-scroll').querySelectorAll('.tx-line');
  allLines.forEach(el => el.classList.remove('lit'));
  const n = Math.min(recent.length, allLines.length);
  for (let i = allLines.length - n; i < allLines.length; i++) allLines[i].classList.add('lit');

  // Loader
  $('ctx-empty').style.display = 'none';
  const loader = mkLoader();
  $('ctx-scroll').prepend(loader);

  const range = recent.length ? `${recent[0].stamp} – ${recent[recent.length-1].stamp}` : 'manual';
  const wall  = new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});

  try {
    // Call our own proxy — no CORS, no API key in browser
    const res = await fetch('/api/explain', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ input })
    });

    if (!res.ok) {
      const e = await res.json().catch(()=>({error:`HTTP ${res.status}`}));
      throw new Error(e.error || `HTTP ${res.status}`);
    }

    const parsed = await res.json();
    loader.remove();
    $('ctx-scroll').prepend(mkCard(parsed, range, wall));
    cardN++;
    $('ccount').textContent = `${cardN} card${cardN!==1?'s':''}`;
    $('ask-ta').value = '';
    scrollB('ctx-scroll');

  } catch(err) {
    loader.remove();
    const ec = document.createElement('div'); ec.className='card';
    ec.innerHTML=`<div class="card-body"><div class="card-slbl" style="color:var(--red)">Error</div><div class="card-sum">${esc(err.message)}</div></div>`;
    $('ctx-scroll').prepend(ec);
  }

  btn.disabled=false; btn.innerHTML='✦ &nbsp;Explain this moment';
}

function mkLoader() {
  const d = document.createElement('div'); d.className='loader';
  d.innerHTML=`<div class="ldots"><span></span><span></span><span></span></div><div class="ltxt">Unpacking the last 90 seconds…</div>`;
  return d;
}

function mkCard(data, range, wall) {
  const terms = (data.terms||[]).map(t=>`
    <div class="card-term">
      <div class="card-tname">${esc(t.name)}</div>
      <div class="card-tdef">${esc(t.definition)}</div>
    </div>`).join('');

  const d = document.createElement('div'); d.className='card';
  d.innerHTML=`
    <div class="card-hd">
      <div class="card-ts">${esc(range)}</div>
      <div class="card-wall">${wall}</div>
    </div>
    <div class="card-body">
      <div><div class="card-slbl">What's happening</div><div class="card-sum">${esc(data.summary)}</div></div>
      ${terms?`<div><div class="card-slbl">Key terms</div><div class="card-terms">${terms}</div></div>`:''}
      ${data.analogy?`<div><div class="card-slbl">Analogy</div><div class="card-analogy">${esc(data.analogy)}</div></div>`:''}
    </div>`;
  return d;
}

document.addEventListener('keydown', e => {
  if (document.activeElement.tagName==='INPUT'||document.activeElement.tagName==='TEXTAREA') return;
  if ((e.key==='e'||e.key==='E') && !e.metaKey && !e.ctrlKey) explain();
});
</script>
</body>
</html>
